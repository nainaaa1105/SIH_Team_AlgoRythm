FROM python:3.11-slim

WORKDIR /srv

# GDAL headers needed by rasterio; libpq-dev for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin libgdal-dev libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# One project now — the gateway (app.main) mounts every member's router,
# so the image needs all of them, not just app/.
COPY app ./app
COPY classifier ./classifier
COPY geospatial ./geospatial
COPY imagery ./imagery
COPY temporal ./temporal
COPY gateway ./gateway
COPY static ./static
COPY scripts ./scripts
COPY alembic.ini .
# Trained classifier — classifier/model/registry.py reads
# data/models/latest/model.json at inference time. Without this the
# container has no model to load and every cluster is left unclassified.
COPY data/models ./data/models
# State/district boundaries — geospatial/admin_boundaries.py resolves
# every detection's location by point-in-polygon against this file.
# Without it every detection reads "outside Indian boundaries" and the
# india_only filter silently no-ops instead of hiding non-India detections.
COPY data/boundaries ./data/boundaries
# GGFR flare registry — the source scripts/bulk_load_gem.py --ggfr reads
# to populate facility_type='flare' rows. Without it, facility_distance_m
# and near_facility (2 of the 28 model features) never see a flare match,
# so gas_flare classification loses its strongest real signal.
COPY data/ggfr_flares ./data/ggfr_flares
# WorldPop population raster (400m, sum-resampled from the real 100m
# product -- 79.6MB vs 1.84GB, total population preserved to 99.9996%
# accuracy). app/enrichment/population.py reads this for population_density
# (a model feature), the WUI "meaningfully populated" gate, and plume
# exposure counts. Without it these silently degrade to unknown rather
# than crashing, but degrade nonetheless.
COPY data/population ./data/population

EXPOSE 8000
# Use PORT env var if provided (Railway/Render inject it), fall back to 8000 for local/docker-compose
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
