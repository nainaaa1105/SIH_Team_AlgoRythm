# --- Database ---
DATABASE_URL=postgresql+psycopg2://sih_user:sih_pass@localhost:5432/sih_thermal
REDIS_URL=redis://localhost:6379/0

# --- NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/) ---
FIRMS_MAP_KEY=4f39f76f82b8ee10eb1f0813448864a1
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
FIRMS_BBOX=68.0,6.5,97.5,37.5
FIRMS_DAY_RANGE=1

# --- Google Earth Engine (OPTIONAL — not required; the real land-cover
# path is geospatial.attribution.landcover_worldcover_cog, which reads
# ESA WorldCover 10m from a public keyless AWS bucket. Only fill this in
# if you later get a GCP service account and want it as an extra tier.) ---
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=secrets/gee-service-account.json

# --- Copernicus Data Space Ecosystem (Sentinel-1/2/3) ---
CDSE_CLIENT_ID=sh-c7008b72-6ae1-48cf-8f30-6a025639a0c1
CDSE_CLIENT_SECRET=ftK7K6erazhNerHkEEY7IuNJm2MiKu7F
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_CATALOG_URL=https://catalogue.dataspace.copernicus.eu/odata/v1

# --- MOSDAC / INSAT-3DS (ISRO) — fill in the moment the account is
# approved; geostationary_supplementary.py switches back to this
# automatically, no code change needed. ---
MOSDAC_USERNAME=sih2026ps162
MOSDAC_PASSWORD=Sih2026@
MOSDAC_BASE_URL=https://mosdac.gov.in

# --- EUMETSAT Data Store (TEMPORARY real-data backup for INSAT-3DS while
# MOSDAC is pending — free, instant, self-service key at
# https://api.eumetsat.int, Profile -> API key. Leave blank to skip. See
# app/ingestion/eumetsat_iodc.py for what this does and its limitations.) ---
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# --- Himawari (NOAA public AWS bucket, no auth needed) ---
HIMAWARI_S3_BUCKET=noaa-himawari8
HIMAWARI_REGION_BBOX=88.0,20.0,97.5,29.5

# --- OSM Overpass ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_INDIA_BBOX=68.0,6.5,97.5,37.5

# --- Open-Meteo (wind, contextual) ---
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Pipeline tuning ---
DBSCAN_EPS_DEGREES=0.005
DBSCAN_MIN_SAMPLES=1
CLOUD_FRACTION_THRESHOLD=0.30
POLL_INTERVAL_MINUTES=30

# --- Emergency SMS dispatch (HttpSMS) — TEST MODE ONLY.
# sms_mode=test always sends to TEST_SMS_RECIPIENT, never a real fire
# station — nearest-fire-station routing is a later phase, see
# app/notifications/sms_recipient.py. Get an API key + register a
# sending Android phone number at https://httpsms.com. ---
SMS_MODE=test
TEST_SMS_RECIPIENT=+91XXXXXXXXXX
HTTPSMS_API_KEY=
HTTPSMS_FROM_NUMBER=
HTTPSMS_BASE_URL=https://api.httpsms.com/v1
FRONTEND_BASE_URL=http://localhost:8000
